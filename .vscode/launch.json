{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MPM (No Build)",
            "type": "cppdbg", // 使用C/C++扩展提供的调试器
            "request": "launch",
            "program": "${workspaceFolder}/build_debug/mpm",
            "args": [
                "-f", "${workspaceFolder}/demo/", // 输入算例所在目录
                "-p", "16", // OpenMP线程数
                "-i", "mpm.json"  // 输入配置文件名
            ], // 传递给程序的命令行参数
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/build_debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb", // 使用GDB作为调试器
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "F11单步进入时,跳过OpenMP和STL内部函数",
                    "text": "skip -gfi /usr/include/c++/*/parallel/*\nskip -gfi /usr/include/c++/*/ext/*\nskip -gfi /usr/lib*/libgomp*.so.*",
                    "ignoreFailures": true
                },
                {
                    "description": "允许未解析的断点",
                    "text": "set breakpoint pending on",
                    "ignoreFailures": true
                }
            ],// 启动GDB后自动执行的调试器命令
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            }
        },
        {
            "name": "Debug_mpmtest_small",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mpmtest_small",
            "args": [
                "-f", "~/mpm-simulations/demo/",
                "-p", "16",
                "-i", "mpmtest_small.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug_mpmtest_unit",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mpmtest_unit",
            "args": [
                "-f", "~/mpm-simulations/demo/",
                "-p", "16",
                "-i", "mpmtest_unit.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}