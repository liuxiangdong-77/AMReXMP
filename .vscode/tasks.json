{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "full-release-build",
            "type": "shell",
            "command": "rm -rf build_release && mkdir -p build_release && cd build_release && cmake -DCMAKE_CXX_COMPILER=g++-13 -DNO_KAHIP=True .. && make clean && make -j16",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Release构建"
        },
        {
            "label": "Generate graded Hex8 mesh",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/graded_hex_mesh/generate_graded_hex_mesh.py",
                "${workspaceFolder}/tools/graded_hex_mesh/graded_hex.example.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}/tools/graded_hex_mesh"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Generate graded orthorhombic Hex8 MPM inputs"
        },
        {
            "label": "full-debug-build",
            "type": "shell",
            "command": "rm -rf build_debug && mkdir -p build_debug && cd build_debug && cmake -DCMAKE_BUILD_TYPE=Debug -DMPM_BUILD_TESTING=OFF -DCMAKE_CXX_COMPILER=g++-13 -DNO_KAHIP=True .. && make clean && make -j16",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Debug构建"
        },
        {
            "label": "run-mpm-demo-release",
            "type": "shell",
            "command": "~/mpm/build_release/mpm -f ~/mpm/demo/ -p 24 -i mpm.json",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}/build_release"
            },
            "problemMatcher": []
        },
        {
            "label": "run-mpm-demo-debug",
            "type": "shell",
            "command": "~/mpm/build_debug/mpm -f ~/mpm/demo/ -p 16 -i mpm.json",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}/build_debug"
            },
            "problemMatcher": []
        },
        {
            "label": "AMR standard case: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build_amr_standard",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_CXX_COMPILER=g++-13",
                "-DCMAKE_PREFIX_PATH=${env:HOME}/opt/amrex-26.11",
                "-DMPM_WITH_AMREX=ON",
                "-DNO_KAHIP=True",
                "-DMPM_BUILD_TESTING=OFF"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "detail": "Configure the standalone AMReX standard-case build directory"
        },
        {
            "label": "AMR standard case: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build_amr_standard",
                "--parallel",
                "8"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "AMR standard case: configure",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "detail": "Build MPM and particle_stress_history for the two-level sine case"
        },
        {
            "label": "AMR standard case: run two-level sine",
            "type": "shell",
            "command": "${workspaceFolder}/build_amr_standard/mpm",
            "args": [
                "-f",
                "${workspaceFolder}/demo/amr_two_level_sine/",
                "-p",
                "4",
                "-i",
                "mpm-two-level-sine.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}/demo/amr_two_level_sine",
                "env": {
                    "OMP_NUM_THREADS": "4"
                }
            },
            "dependsOn": "AMR standard case: build",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "Run the 10 m cube with two AMR levels and 500 Hz sinusoidal excitation"
        },
        {
            "label": "AMR standard case: extract stress history",
            "type": "shell",
            "command": "${workspaceFolder}/build_amr_standard/particle_stress_history",
            "args": [
                "--dir",
                "results-amr-two-level-sine/amr-two-level-sine-000",
                "--x",
                "5.125",
                "--y",
                "5.125",
                "--z",
                "5.125",
                "--dt",
                "1e-5",
                "--output",
                "excitation_stress.csv"
            ],
            "options": {
                "cwd": "${workspaceFolder}/demo/amr_two_level_sine"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Extract stress history at the sinusoidal excitation particle"
        },
        {
            "label": "AMR standard case: run then extract",
            "dependsOrder": "sequence",
            "dependsOn": [
                "AMR standard case: run two-level sine",
                "AMR standard case: extract stress history"
            ],
            "problemMatcher": [],
            "detail": "Run the two-level sine case and generate excitation_stress.csv"
        }
    ]
}
